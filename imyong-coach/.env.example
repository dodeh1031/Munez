# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.  (cp .env.example .env.local)
# 값을 바꾼 뒤에는 개발 서버(npm run dev)를 다시 시작해야 적용됩니다.

# Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 기본 분석 모델 (기본값: gemini-4-hydrogen) — 입력 화면에서 분석할 때마다 Hydrogen·Neon 중 고를 수 있습니다.
#  - 무료 등급에서는 쓸 수 없는 모델도 있으니 결제 연결을 권장합니다.
#  - gemini-4-argon, gemini-2.5-pro는 목록에서 빠지거나 서비스 종료 중이라 막힐 수 있습니다.
#  - 여기 적은 모델은 화면의 선택지에도 자동으로 추가됩니다.
GEMINI_MODEL=gemini-4-hydrogen

# 추론 깊이 (Gemini 3·4 계열): low | medium | high | xhigh  (비우면 모델 기본값 — Neon은 high)
#  - 높을수록 더 깊이 따져 보고 채점하지만 시간이 더 걸리고 출력 토큰(비용)이 늘어납니다.
#  - 비용을 아끼려면 medium, 가장 꼼꼼하게 보려면 xhigh
GEMINI_THINKING_LEVEL=

# 영상 해상도(토큰 사용량): low | medium | high  (기본값: low)
#  - low   : 프레임당 약 64토큰. 15분 영상도 토큰이 적어 비용·속도에 유리
#  - medium: 프레임당 약 256토큰. 표정·시선을 더 자세히 보지만 토큰이 약 3배
GEMINI_MEDIA_RESOLUTION=low

# 1로 두면 API를 호출하지 않고 샘플 리포트로 화면 흐름만 테스트합니다.
GEMINI_MOCK=

# (선택) 프록시나 테스트 서버를 쓸 때만 지정. 보통은 비워 두세요.
GEMINI_BASE_URL=
