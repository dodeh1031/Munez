# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.  (cp .env.example .env.local)
# 값을 바꾼 뒤에는 개발 서버(npm run dev)를 다시 시작해야 적용됩니다.

# Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 분석에 사용할 Gemini 모델 (기본값: gemini-2.5-pro)
# "모델을 사용할 수 없습니다" 오류가 나면 최신 Pro 모델 이름으로 바꾸세요.
GEMINI_MODEL=gemini-2.5-pro

# 영상 해상도(토큰 사용량): low | medium | high  (기본값: low)
#  - low   : 프레임당 약 64토큰. 15분 영상도 토큰이 적어 비용·속도에 유리
#  - medium: 프레임당 약 256토큰. 표정·시선을 더 자세히 보지만 토큰이 약 3배
GEMINI_MEDIA_RESOLUTION=low

# 1로 두면 API를 호출하지 않고 샘플 리포트로 화면 흐름만 테스트합니다.
GEMINI_MOCK=

# (선택) 프록시나 테스트 서버를 쓸 때만 지정. 보통은 비워 두세요.
GEMINI_BASE_URL=
